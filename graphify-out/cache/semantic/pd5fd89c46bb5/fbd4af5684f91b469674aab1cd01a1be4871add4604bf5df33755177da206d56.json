{"nodes": [{"id": "docs_superpowers_plans_2026_07_30_codex_efficiency_fixes", "label": "Codex Efficiency Fixes Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-30-codex-efficiency-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_30_codex_efficiency_fixes_worker_review_prohibition", "label": "Worker Review Prohibition", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-30-codex-efficiency-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Depth-2 worker-spawned reviewers were 9/9 same-task duplicate reviews across four corpora \u2014 every reviewer a worker spawned duplicated the task review the controller dispatched anyway, at full cost."}, {"id": "docs_superpowers_plans_2026_07_30_codex_efficiency_fixes_event_driven_waiting", "label": "Event-Driven Child Waiting", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-30-codex-efficiency-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long waits eliminated timeouts (65.1% to 0.0%) but produced 20-38 min silent transcripts and let one child in 51 vanish unnoticed; bounded 5-10 min stretches with a status line and list_agents reconcile keep the efficiency and restore observability."}, {"id": "docs_superpowers_plans_2026_07_30_codex_efficiency_fixes_multiagent_rewrite", "label": "codex-tools.md Version-Honest Multi-Agent Rewrite", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-30-codex-efficiency-fixes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_30_codex_efficiency_fixes_model_routing", "label": "Model Routing on Spawns", "file_type": "concept", "sour