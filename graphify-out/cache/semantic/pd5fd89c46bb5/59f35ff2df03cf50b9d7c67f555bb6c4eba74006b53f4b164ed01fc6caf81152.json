{"nodes": [{"id": "skills_diagnosing_superpowers_skill", "label": "diagnosing-superpowers (SKILL.md)", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin down what went wrong, read the transcripts on disk, and report with evidence; you report \u2014 you do not diagnose superpowers. Whoever triages the bundle or the issue decides whether superpowers changes."}, {"id": "skills_diagnosing_superpowers_skill_problem_intake", "label": "Problem intake (workflow step 1)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'It took too long' is a complaint, not a problem statement \u2014 the statement naming sessions, turn range, expectation, and the observable scopes everything downstream."}, {"id": "skills_diagnosing_superpowers_skill_locate", "label": "Locate (workflow step 2)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolve sessions to verified absolute paths; confirm a past session by quoting its first prompt and timestamp, and list every rejected candidate with the reason."}, {"id": "skills_diagnosing_superpowers_skill_triage", "label": "Triage (workflow step 3)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read the region around the reported problem yourself, then run one analyst per dimension in parallel; discard any finding without path:line and split dimensions by turn range on long transcripts."}, {"id": "skills_diagnosing_superpowers_skill_report", "label": "Report (workflow step 4)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fill every section of the report in order and check what cited content actually proves; a symlink alias is not a redundant copy."}, {"id": "skills_diagnosing_superpowers_skill_github_issues", "label": "GitHub issues (workflow step 5)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search open and closed issues for the symptoms first; create an issue only after the partner approves the exact text \u2014 gh cannot attach files, so the partner attaches the bundle in the browser."}, {"id": "skills_diagnosing_superpowers_skill_export", "label": "Export (workflow step 6)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never build a bundle unprompted \u2014 it is the partner's session data, packaged; scrub then audit repeat until the audit returns CLEAN, and archive only after approval."}, {"id": "skills_diagnosing_superpowers_skill_similar_sessions", "label": "Similar sessions (workflow step 7)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn confirmed findings into a signature, list candidates by mtime and size, and check each in parallel to find recurrence."}, {"id": "skills_diagnosing_superpowers_skill_skill_timeline", "label": "skill-timeline analyst dimension (prompts/skill-timeline.md)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_plan_adherence", "label": "plan-adherence analyst dimension (prompts/plan-adherence.md)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_repeated_work", "label": "repeated-work analyst dimension (prompts/repeated-work.md)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_stumbles", "label": "stumbles analyst dimension (prompts/stumbles.md)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_quality_evidence", "label": "quality-evidence analyst dimension (prompts/quality-evidence.md)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_request_conflicts", "label": "request-conflicts analyst dimension (prompts/request-conflicts.md)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_cost_and_time", "label": "cost-and-time analyst dimension (prompts/cost-and-time.md)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_context_safety_rule", "label": "Context safety (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One transcript line can be a megabyte \u2014 follow references/context-safety.md on every session file, every time."}, {"id": "skills_diagnosing_superpowers_skill_dispatch_or_inline_rule", "label": "Dispatch or inline (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Where a step says dispatch, use a subagent tool if available; otherwise run that prompt yourself \u2014 keeps analyst, scrub, and similar-session prompts runnable in inline-only environments."}, {"id": "skills_diagnosing_superpowers_skill_read_only_rule", "label": "Read-only (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session files are the evidence under investigation; never modify, move, or delete one."}, {"id": "skills_diagnosing_superpowers_skill_exact_paths_rule", "label": "Exact paths to subagents (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A subagent's 'current session' is its own \u2014 pass absolute paths and ids or the analyst reads the wrong session."}, {"id": "skills_diagnosing_superpowers_skill_human_prompts_only_rule", "label": "Human prompts only (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hook output, system reminders, and tool results are not the partner's words; in a subagent transcript 'user' is the parent agent."}, {"id": "skills_diagnosing_superpowers_skill_no_superpowers_diagnosis_rule", "label": "No superpowers diagnosis (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Report \u00a77 states involvement and stops \u2014 never name a defect in a skill or propose a change; partner pressure does not waive this."}, {"id": "skills_diagnosing_superpowers_skill_approval_gates_rule", "label": "Approval gates (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No archive before the partner has seen the scrub log and file list; no issue or comment before they approve the exact text."}, {"id": "skills_diagnosing_superpowers_skill_intake_before_analysis_rule", "label": "Intake before analysis (hard rule)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unscoped sweep spends the budget on the wrong question; a statement reconstructed for the partner is not an answer."}, {"id": "skills_diagnosing_superpowers_skill_path_line_citation_principle", "label": "Every finding cites path:line (core principle)", "file_type": "concept", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No citation, no finding \u2014 every number comes from the transcript or from a command you ran, never from memory."}, {"id": "skills_diagnosing_superpowers_skill_session_discovery_reference", "label": "references/session-discovery.md", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_context_safety_reference", "label": "references/context-safety.md", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_github_issues_reference", "label": "references/github-issues.md", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_case_template", "label": "templates/case.md", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_report_template", "label": "templates/report.md", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_issue_template", "label": "templates/issue.md", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnosing_superpowers_skill_bundle_readme_template", "label": "templates/bundle-README.md", "file_type": "document", "source_file": "skills/diagnosing-superpowers/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_diagnos