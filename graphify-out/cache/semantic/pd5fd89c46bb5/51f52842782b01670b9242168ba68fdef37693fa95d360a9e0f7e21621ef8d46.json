{"nodes": [{"id": "docs_superpowers_specs_2026_06_10_positive_instruction_redesign_design_document", "label": "Positive-Instruction Redesign of Skill Guidance Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-10-positive-instruction-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_10_positive_instruction_redesign_design_positive_instruction_doctrine", "label": "Positive-Instruction Doctrine", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-10-positive-instruction-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured 2026-06-10: tripwires, recognition tables, and discrete-directive prohibitions work; composition prohibitions backfire when the model has its own agenda (4.4 vs 3.6 control vs 3.0 recipe); nuance clauses dilute winning recipes; ties go to shorter phrasing (Codex re-reads SKILL.md ~500x per long session)."}, {"id": "docs_superpowers_specs_2026_06_10_positive_instruction_redesign_design_micro_test_harness", "label": "Micro-Test Harness for Prompt Guidance", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-positive-instruction-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One API call per sample at ~0.15-0.30 USD vs 12 USD full eval runs; programmatic scoring with manual inspection of every match; always include a no-guidance control."}, {"id": "docs_superpowers_specs_2026_06_10_positive_instruction_redesign_design_no_placeholders_section", "label": "writing-plans No Placeholders Section", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-positive-instruction-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author"