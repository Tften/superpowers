{"nodes": [{"id": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_document", "label": "Zero-Dependency Brainstorm Server Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_server_js", "label": "Zero-Dependency server.js", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendored node_modules (express, ws, chokidar; 714 tracked files) is a supply-chain risk: frozen deps get no patches and unaudited code looks like normal commits; one file on Node built-ins eliminates it. Run directly it starts the server; required it exports protocol functions for tests."}, {"id": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_rfc_6455_websocket", "label": "RFC 6455 WebSocket Protocol Implementation", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text frames only; binary frames, fragmentation, extensions, and subprotocols deliberately skipped - unnecessary for small JSON messages between localhost clients, and unadvertised extensions are never active."}, {"id": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_fs_watch", "label": "fs.watch File Watching", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces chokidar; reliable for single flat directories on macOS, Linux, and Windows; ~100ms per-filename debounce prevents duplicate events."}, {"id": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_server_info_file", "label": ".server-info Connection File", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Startup JSON written to the screen directory so agents can find connection details when stdout is hidden by background execution."}], "edges": [{"source": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_document", "target": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_server_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_document", "target": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_rfc_6455_websocket", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_document", "target": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_fs_watch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-03-11-zero-dep-brainstorm-server-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_document", "target": "docs_superpowers_specs_2026_03_11_zero_dep_brainstorm_server_design_server_info_file", "relatio