{"nodes": [{"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_document", "label": "Strict-Cost SDD Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_experiment_ladder", "label": "Strict-Cost Experiment Ladder", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimize dollars per plan-execution with quality as the hard invariant (N=5 scenario gates, blind A/B deliverable parity); each rung ships only with gate evidence and any quality regression kills the rung."}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_judgment_guardrail", "label": "Cheapen-Mechanics-Never-Judgment Guardrail", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Judgment failures are rare-event, high-blast-radius, and largely invisible to pass/fail gates; every tier change must enumerate which decisions move to a cheaper model and prove each is mechanical, with a judgment audit on top."}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_thesis_guardrail", "label": "SDD Thesis Guardrail (Fresh Subagent Per Task)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDD's thesis is a fresh subagent per task with precisely curated context, gated per task; dispatch-time task batching is counter-thesis (pollutes fresh context, coarsens gates) - the sanctioned route is plan-time task right-sizing."}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_l1_plan_side_crispness", "label": "L1 Plan-Side Crispness", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plan is upstream of every cost (task count sets dispatch count, ambiguity sets review-loop count); measured result: the dollar win belongs to opus-written complete-code plans, while the guidance owns fidelity and variance (deterministic constraints propagation, exact interfaces, fewer fix waves)."}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_l2_controller_tier", "label": "L2 Controller Tier Experiment", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The controller is half the dollars solely because it inherits the session model; died at the gates as pre-registered - cheap controllers escalate explicit conflicts (5/5) but absorb implicit authority-vs-quality adjudication (planted defect shipped 4/5)."}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_l3_reviewer_tier", "label": "L3 Reviewer Tier Experiment", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dead as pre-registered: per-task haiku reviewers flagged 0 of 10 planted defects at correct severity - cheap reviewers fail by advocating for defects (DRY praised as YAGNI, assert-nothing test called plan-compliant)."}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_l4_resident_context_diet", "label": "L4 Resident-Context Diet", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trim resident context: task-brief list mode (headings plus Global Constraints, never the full plan), 8-line reports, SKILL.md minification - Codex pays ~10k chars times ~500 re-reads per long session."}, {"id": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_sdd_escalates_broken_plan_scenario", "label": "sdd-escalates-broken-plan Eval Scenario", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New scenario with an explicit plan self-contradiction the human never volunteers; passed 5/5 at sonnet (opus baseline 2/2) - cheap controllers handle explicit escalation, not implicit adjudication."}], "edges": [{"source": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_document", "target": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_experiment_ladder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_document", "target": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_judgment_guardrail", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-10-strict-cost-sdd-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_document", "target": "docs_superpowers_specs_2026_06_10_strict_cost_sdd_design_thesis_guardrail", "relation": "references", "confidence": "EXTRACTED", "confidence_