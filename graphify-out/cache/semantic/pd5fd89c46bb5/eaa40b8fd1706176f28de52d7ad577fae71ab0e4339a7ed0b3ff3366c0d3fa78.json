{"nodes": [{"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_document", "label": "Codex App Compatibility Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_environment_detection", "label": "Read-Only Git Environment Detection", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three read-only git commands detect the environment without side effects; git-dir vs git-common-dir identifies a linked worktree and avoids the submodule false positive that show-toplevel would produce; cd plus pwd -P handles relative paths and symlinks."}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_in_linked_worktree_signal", "label": "IN_LINKED_WORKTREE Signal", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GIT_DIR != GIT_COMMON means the agent is in a worktree created by something else (Codex App, Agent tool, previous skill run, or the user)."}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_on_detached_head_signal", "label": "ON_DETACHED_HEAD Signal", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empty branch name means no named branch exists - the agent cannot create branches, push, or open PRs from the sandbox."}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_sandbox_fallback", "label": "Sandbox Fallback Behavior", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A permission error on git worktree add (e.g. Seatbelt denial) means a late-detected restricted environment: skip creation, run setup and baseline tests in place."}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_codex_app_handoff", "label": "Codex App Finishing Handoff Payload", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The sandbox blocks checkout -b, push, and gh pr create; the agent commits all work and hands off to the App's native controls (Create branch, Hand off to local) with suggested branch name and commit message."}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_using_git_worktrees_skill", "label": "using-git-worktrees skill", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_finishing_a_development_branch_skill", "label": "finishing-a-development-branch skill", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-03-23-codex-app-compatibility-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_03_23_codex_app_compatibility_design_subagent_driven_development_skill", "label": "subagent-driven-development skill", "file_type": "concept", "source_fi