{"nodes": [{"id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_document", "label": "Lift Drill into superpowers as evals/ Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_drill_benchmark", "label": "Drill Skill-Compliance Benchmark", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drill (obra/drill) drives real tmux sessions with an LLM actor and verifier; already the de facto eval harness after the PRI-1397 series lifted ~22 bash tests into drill scenarios."}, {"id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_evals_directory", "label": "evals/ Canonical Eval Harness", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The split is meaningful: tests/ = non-LLM plugin infrastructure (bash/node/python); evals/ = LLM behavior with actor plus verifier on real tmux sessions."}, {"id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_superpowers_root_default", "label": "SUPERPOWERS_ROOT Auto-Default", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the move, cli.py's PROJECT_ROOT.parent resolves to the repo root; a helper sets the env var when unset, removing the export step from contributor setup."}, {"id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_deletion_gate", "label": "Bash Test Deletion Gate", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bash test is deleted only if a drill scenario verifiably covers every assertion it makes; if even one check is missing, extend the scenario or keep the test - default keeps it."}, {"id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_subagent_gated_verification", "label": "Subagent-Gated Verification Protocol", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every change gets cross-checked by an independent subagent before commit (per-file SHA-256 checksums, per-assertion coverage tables, reference scrubbing); the subagent's output is the gate and the trail is auditable in commit messages."}], "edges": [{"source": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_document", "target": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_drill_benchmark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_document", "target": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_evals_directory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-05-06-lift-drill-into-evals-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_document", "target": "docs_superpowers_specs_2026_05_