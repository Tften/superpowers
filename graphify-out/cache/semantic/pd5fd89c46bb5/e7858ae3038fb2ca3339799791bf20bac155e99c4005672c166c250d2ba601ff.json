{"nodes": [{"id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_document", "label": "Visual Companion Final Hardening Fixup Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-11-visual-companion-final-hardening-fixup-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_root_screen_containment", "label": "Root Screen Containment", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-11-visual-companion-final-hardening-fixup-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The root GET / screen-selection path could serve symlink or hardlink escapes; getNewestScreen() applies the same realpath guard as /files/* plus a link-count rejection (nlink must be exactly 1)."}, {"id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_fallback_token_isolation", "label": "Fallback Token Isolation", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-11-visual-companion-final-hardening-fixup-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Port fallback reusing a persisted .last-token creates two live same-project servers sharing one bearer key; fallback generates a fresh unpersisted token, and an explicit BRAINSTORM_TOKEN env override fails closed."}, {"id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_stop_server_ownership_proof", "label": "Stop-Server Instance-ID Ownership Proof", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-11-visual-companion-final-hardening-fixup-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": nu