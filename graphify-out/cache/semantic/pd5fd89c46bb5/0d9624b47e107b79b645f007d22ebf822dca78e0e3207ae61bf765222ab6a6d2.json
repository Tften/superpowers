{"nodes": [{"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_document", "label": "Visual Brainstorming Refactor Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_events_file", "label": ".events Per-Screen Event Stream", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server appends user events as JSON lines to $SCREEN_DIR/.events so the agent reads the full exploration path on its next turn; cleared when a new screen is pushed; replaces blocking event delivery."}, {"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_browser_displays_terminal_commands", "label": "Browser Displays, Terminal Commands Model", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turn-based execution cannot listen on two channels in one turn; blocking TaskOutput seized the TUI entirely, so the browser becomes display-only and the terminal stays the conversation channel."}, {"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_wait_for_feedback_sh", "label": "wait-for-feedback.sh (deleted script)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bridged server stdout events to the agent via a blocking background task; deleted entirely because the .events file lets the agent read interactions with platform-native file reads."}, {"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_selection_indicator_bar", "label": "Selection Indicator Bar", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the removed feedback footer; guides the user back to the terminal after clicking an option."}, {"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_wrapinframe_injection", "label": "wrapInFrame Comment-Placeholder Injection", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old regex anchored on the removed feedback-footer div; a single comment placeholder makes injection simpler and resilient to template formatting changes."}, {"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_brainstorm_server", "label": "brainstorm-server (lib/brainstorm-server)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Platform-agnostic Node.js and browser JavaScript with no harness-specific references; the skill instructions are the platform-adaptive layer."}, {"id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_helper_js", "label": "helper.js client script", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-02-19-visual-brainstorming-refactor-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": 