{"nodes": [{"id": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_document", "label": "SDD Fix-Loop Redesign Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_fix_loop_circuit_breaker", "label": "Fix-Loop Circuit Breaker", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeat-until-approved with fresh full reviews never converged - a nondeterministic frontier reviewer surfaced new findings every round; five rounds (three resumes of the original implementer, then two fresh dispatches on a more capable model) de-anchor and capability-bump in one move."}, {"id": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_scoped_re_review", "label": "Scoped Re-Review", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fresh full reviews each round are the churn engine; scoped re-reviews (fix-scoped diff package, per-finding verdicts) make the loop structurally convergent while the final whole-branch review remains the broad safety net."}, {"id": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_re_review_prompt", "label": "re-review-prompt.md", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate template because the scoped re-review is a different contract - overloading the full-review template produced the current ambiguity."}, {"id": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_adjudication_at_trip", "label": "Controller Adjudication at Circuit-Breaker Trip", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The controller holds the plan and cross-task context the reviewer lacks; contested findings are ledgered, load-bearing ones reach the existing BLOCKED stop - no new human checkpoint, and every adjudication is a ledger entry; silent discards stay forbidden."}, {"id": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_rationalization_table", "label": "Excuse/Reality Rationalization Table", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven sibling skills use the Excuse/Reality table while SDD carried a 17-bullet Never list; excuses get rebuttals and hard rules move to their points of use."}], "edges": [{"source": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_document", "target": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_fix_loop_circuit_breaker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_document", "target": "docs_superpowers_specs_2026_07_15_sdd_fix_loop_redesign_design_scoped_re_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-15-sdd-fix-loop-redesign-design.md", "source_location": null