{"nodes": [{"id": "skills_executing_plans_skill", "label": "executing-plans (skill)", "file_type": "document", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_inline_execution", "label": "Inline execution", "file_type": "concept", "rationale": "Every dispatch pays for a fresh context that re-reads the codebase from zero; inline pays for one context plus one final review, keeping what per-task fresh context and second-pair-of-eyes bought by other means: the brief is the spec, the ledger is your memory, TDD is the per-task gate, the final review is the second pair of eyes.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_continuous_execution", "label": "Continuous execution (no check-ins between tasks)", "file_type": "concept", "rationale": "The human partner chose inline execution to spend less, not to answer 'should I continue?' after every task; only the four stop conditions stop you.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_ruling", "label": "Ruling (ledgered decision)", "file_type": "concept", "rationale": "Conflicts, ambiguities and plan defects are decided, not stalled over; deviating from the plan without a ledgered ruling is a decision made in secret. Format: Ruling: <what you decided> \u2014 <why> \u2014 <what it costs if wrong>.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_stop_conditions", "label": "Four stop conditions", "file_type": "concept", "rationale": "Only an irreversible/destructive operation, a security-sensitive action, a side effect outside the worktree that norms say to ask about first, or a plan so broken every path is a guess, stop execution for a human decision.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_workspace", "label": "SDD workspace (per-plan git-ignored directory)", "file_type": "concept", "rationale": "Each plan owns <repo-root>/.superpowers/sdd/<plan-basename>/ holding ledger, briefs and review packages; another plan's directory is never yours to read or write. Deleted when the final review is clean \u2014 the git history is the record then.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_ledger", "label": "SDD ledger (progress.md)", "file_type": "concept", "rationale": "Conversation memory does not survive compaction; an inline executor that loses its place re-implements tasks whose commits already exist. Harness todos are a live view; the ledger is the record. First line names the plan; Task <N>: complete lines mark done work.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_sdd_format", "label": "Shared SDD format", "file_type": "concept", "rationale": "Workspace and ledger use the same directory and format as SDD so any session can resume a plan mid-flight from the same ledger.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_brief", "label": "Task brief", "file_type": "concept", "rationale": "What you remember from setup is a summary; the brief has the exact values, signatures and test cases, so it is read for every task including remembered ones.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_pre_flight_scan", "label": "Pre-flight interface scan", "file_type": "concept", "rationale": "Before Task 1, the plan's Interfaces blocks are scanned for conflicts between tasks; each shared-interface row is ledgered and ruled with the spec as binding authority, because each task's own text is only checked when its brief is read.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_task_loop", "label": "Task loop (task-start \u2192 steps \u2192 completion contract \u2192 task-done)", "file_type": "concept", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_completion_contract", "label": "Completion contract", "file_type": "concept", "rationale": "All contract items must be true with evidence in this session \u2014 not inferred from the diff looking right; every named test ran and was read, every Expected: line compared, every deviation has a Ruling: line.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_final_review", "label": "Final whole-branch review", "file_type": "concept", "rationale": "Same author, same blind spots \u2014 this is the one fresh context the whole inline run buys; do not skip it or replace it with your own read of the diff. Dispatch a reviewer on the most capable model if a subagent tool exists, else self-review from code-reviewer.md and say so.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_regrade", "label": "Re-grade findings by effect", "file_type": "concept", "rationale": "The spec is a vision document; a finding's grade is what a reasonable person using this software gets if it ships, not whether the spec names the triggering input \u2014 a reviewer who graded Minor because the spec was silent graded the spec, not the effect. The reviewer's severity labels are advice; the gate is yours.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_fix_pass", "label": "One fix pass (each fix RED\u2192GREEN + green suite)", "file_type": "concept", "rationale": "Critical and Important findings are fixed by the implementer in ONE pass, each verified by TDD \u2014 a fix without a test that failed first is not verified. Minor findings are ledgered as deferred and never fixed in the pass. No re-review: covering tests answer 'addressed', the suite run answers 'broke nothing'.", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_common_rationalizations", "label": "Common rationalizations table (executing-plans)", "file_type": "concept", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_sdd_workspace_script", "label": "scripts/sdd-workspace", "file_type": "code", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_task_start_script", "label": "scripts/task-start", "file_type": "code", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_task_done_script", "label": "scripts/task-done", "file_type": "code", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_executing_plans_skill_review_package_script", "label": "scripts/review-package", "file_type": "code", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_plans_skill", "label": "writing-plans (skill)", "file_type": "document", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_using_git_worktrees_skill", "label": "using-git-worktrees (skill)", "file_type": "document", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_test_driven_development_skill", "label": "test-driven-development (skill)", "file_type": "document", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_systematic_debugging_skill", "label": "systematic-debugging (skill)", "file_type": "document", "source_file": "skills/executing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_verification_before_completion_skill", "label": "verification-before-completion (skill)", "file_type": "document", "source_file": "skills/executing-plans/SKILL.md", "source_locat