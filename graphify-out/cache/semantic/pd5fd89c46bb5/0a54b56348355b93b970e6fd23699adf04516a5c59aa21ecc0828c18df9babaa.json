{"nodes": [{"id": "skills_systematic_debugging_skill", "label": "Systematic Debugging Skill", "file_type": "document", "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_systematic_debugging_skill_iron_law", "label": "The Iron Law: No Fixes Without Root Cause Investigation", "file_type": "rationale", "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core principle: ALWAYS find root cause before attempting fixes; symptom fixes are failure. Absolute language (ALWAYS/NEVER, 'even if faster', 'even if I seem in a hurry') was deliberately chosen to resist time pressure and rationalization."}, {"id": "skills_systematic_debugging_skill_four_phase_framework", "label": "Four-Phase Debugging Framework", "file_type": "rationale", "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Investigation, Pattern Analysis, Hypothesis, Implementation - extracted from CLAUDE.md debugging rules. Phase 1 is mandatory before any fix so implementation cannot skip investigation; each phase gates the next."}, {"id": "skills_systematic_debugging_skill_single_hypothesis_rule", "label": "Single Hypothesis Rule", "file_type": "rationale", "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Structural defense: forming and testing exactly one hypothesis forces thinking and prevents shotgun fixes; test the smallest possible change, one variable at a time."}, {"id": "skills_systematic_debugging_skill_three_fix_architecture_rule", "label": "Question Architecture After 3+ Failed Fixes", "file_type": "rationale", "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3+ failed fixes indicate a wrong architecture rather than a failed hypothesis: stop, question fundamentals, and discuss with your human partner before attempting fix #4."}], "edges": [{"source": "skills_systematic_debugging_skill", "target": "skills_systematic_debugging_root_cause_tracing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_systematic_debugging_defense_in_depth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_systematic_debugging_condition_based_waiting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_test_driven_development_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_verification_before_completion_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_systematic_debugging_skill_iron_law", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_systematic_debugging_skill_four_phase_framework", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_systematic_debugging_skill_single_hypothesis_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_systematic_debugging_skill", "target": "skills_systematic_debugging_skill_three_fix_architecture_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "systematic_debugging_supporting_techniques", "label": "Systematic Debugging Supporting Techniques", "nodes": ["skills_systematic_debugging_skill", "skills_systematic_debugging_root_cause_tracing", "skills_systematic_debugging_defense_in_depth", "skills_systematic_debugging_condition_based_waiting"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/systematic-debugging/SKILL.md"}]}