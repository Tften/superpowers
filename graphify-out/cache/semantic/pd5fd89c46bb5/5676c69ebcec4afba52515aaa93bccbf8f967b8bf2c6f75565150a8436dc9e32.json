{"nodes": [{"id": "docs_superpowers_plans_2026_07_06_sdd_plan_scoped_workspace", "label": "SDD Plan-Scoped Workspace Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-06-sdd-plan-scoped-workspace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_06_sdd_plan_scoped_workspace_plan_scoped_workspace", "label": "Plan-Scoped Workspace Directory (.superpowers/sdd/<plan-stem>/)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-06-sdd-plan-scoped-workspace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One directory per plan so a follow-up plan can never read or overwrite another plan's artifacts; a stale ledger misread as current progress makes controllers skip whole task sequences. The workspace lives in the working tree (not .git/) because Claude Code denies agent writes under .git/, and a self-ignoring .gitignore keeps it out of git status."}, {"id": "docs_superpowers_plans_2026_07_06_sdd_plan_scoped_workspace_sdd_workspace_script", "label": "scripts/sdd-workspace.sh", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-06-sdd-plan-scoped-workspace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_06_sdd_plan_scoped_workspace_self_identifying_ledger", "label": "Self-Identifying Progress Ledger", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-06-sdd-plan-scoped-workspace.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_06_sdd_plan_scoped_workspace_forensic_disambiguation_tax", "label": "Forensic Disambiguation Tax", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-06-sdd-plan-s