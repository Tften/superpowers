{"nodes": [{"id": "skills_requesting_code_review_skill", "label": "requesting-code-review (skill)", "file_type": "document", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_requesting_code_review_code_reviewer", "label": "code-reviewer.md (review template)", "file_type": "document", "rationale": "The reviewer works from precisely crafted context \u2014 the diff, the plan, the requirements \u2014 never the session's history; that keeps the review on the work product, not the author's thought process.", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_requesting_code_review_skill_dual_mode_review", "label": "Dual-mode review (dispatch subagent or self-review)", "file_type": "concept", "rationale": "With a subagent tool, dispatch a general-purpose reviewer with an explicitly specified most-capable model (a judgment task); without one, perform the code-reviewer.md review yourself as a separate pass \u2014 a self-review by the author is weaker than a fresh reviewer, and the human partner decides whether that is enough before merge.", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_requesting_code_review_skill_review_range", "label": "Review range (BASE_SHA/HEAD_SHA)", "file_type": "concept", "rationale": "BASE_SHA from git merge-base main HEAD (or HEAD~1) and HEAD_SHA from git rev-parse HEAD bound the diff handed to the reviewer.", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_requesting_code_review_skill_severity_levels", "label": "Severity levels (Critical/Important/Minor)", "file_type": "concept", "rationale": "Fix Critical issues immediately, fix Important before proceeding, note Minor for later \u2014 severity gates how feedback is acted on.", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_requesting_code_review_skill_push_back", "label": "Push back on wrong reviewer feedback", "file_type": "concept", "rationale": "If the reviewer is wrong, push back with technical reasoning, show code/tests that prove it works, or request clarification \u2014 never argue with valid technical feedback.", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_requesting_code_review_skill_review_early_review_often", "label": "Review early, review often (core principle)", "file_type": "concept", "rationale": "Get a code review before issues cascade; tests prove the code does what you meant, review asks whether what you meant is what the plan requires \u2014 different question, different gate.", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_requesting_code_review_skill_common_rationalizations", "label": "Common rationalizations table (requesting-code-review)", "file_type": "concept", "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_requesting_code_review_skill", "target": "skills_requesting_code_review_skill_review_early_review_often", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/requesting-code-review/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "skills_reque