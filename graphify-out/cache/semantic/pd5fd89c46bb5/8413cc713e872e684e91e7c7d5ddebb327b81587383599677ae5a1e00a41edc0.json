{"nodes": [{"id": "skills_test_driven_development_writing_good_tests_reference", "label": "Writing Good Tests \u2014 TDD \u6280\u80fd\u7684\u6d4b\u8bd5\u7f16\u5199\u53c2\u8003\u6587\u6863", "file_type": "document", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5199\u6d4b\u8bd5\u3001\u6539\u6d4b\u8bd5\u3001\u52a0 mock \u6216\u6d4b\u8bd5\u6e05\u7406/\u8f85\u52a9\u65b9\u6cd5\u65f6\u52a0\u8f7d;\u4e00\u4e2a\u6d4b\u8bd5\u7684\u5b58\u5728\u662f\u4e3a\u4e86\u6355\u83b7\u4e00\u79cd\u7279\u5b9a\u7684\u7834\u574f,\u4e24\u6761\u539f\u5219\u652f\u914d\u4e00\u5207\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_naming_the_break", "label": "\u539f\u5219 1:\u6bcf\u4e2a\u6d4b\u8bd5\u547d\u540d\u5b83\u6355\u83b7\u7684\u7834\u574f(Name the Break)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5199\u6d4b\u8bd5\u4f53\u524d\u5148\u56de\u7b54:\u4ec0\u4e48\u751f\u4ea7\u53d8\u66f4\u5e94\u8ba9\u6b64\u6d4b\u8bd5\u5931\u8d25,\u8be5\u53d8\u66f4\u662f bug \u8fd8\u662f\u51b3\u7b56;\u6d4b\u8bd5\u9760\u6355\u83b7\u9519\u8bef\u5206\u652f\u3001\u7f3a\u5931\u526f\u4f5c\u7528\u3001\u9519\u8bef\u53c2\u6570\u3001\u8fb9\u754c\u60c5\u5f62\u6216\u7834\u574f\u7684\u5951\u7ea6\u6765\u8d62\u5f97\u4f4d\u7f6e;\u4e25\u683c TDD \u81ea\u7136\u4ea7\u51fa\u4e24\u6761\u539f\u5219\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_exercising_the_real_thing", "label": "\u539f\u5219 2:\u6bcf\u4e2a\u6d4b\u8bd5\u953b\u70bc\u771f\u5b9e\u5bf9\u8c61(Exercise the Real Thing)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5148\u5199\u5e76\u770b\u7740\u5bf9\u771f\u5b9e\u4ee3\u7801\u5931\u8d25\u7684\u6d4b\u8bd5\u5df2\u8bc1\u660e\u5b83\u80fd\u5931\u8d25;\u53ea\u6709\u5f53\u771f\u5b9e\u4f9d\u8d56\u88ab\u8bc1\u660e\u6162\u6216\u5916\u90e8\u65f6,\u624d\u8d62\u5f97\u4e00\u4e2a mock\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_independent_expectations", "label": "\u72ec\u7acb\u63a8\u5bfc\u671f\u671b\u503c(\u5b57\u9762\u91cf\u4e0e\u624b\u5de5\u6821\u9a8c fixture)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u7528\u88ab\u6d4b\u4ee3\u7801\u6216\u5176\u8f85\u52a9\u51fd\u6570\u7b97\u51fa\u7684\u671f\u671b\u65e0\u8bba\u4ee3\u7801\u505a\u4ec0\u4e48\u90fd\u4f1a\u901a\u8fc7;\u8868\u9a71\u52a8\u6d4b\u8bd5\u52a0\u5b57\u9762\u91cf want \u503c\u662f\u9996\u9009\u5f62\u6001;\u955c\u50cf\u65ad\u8a00(\u540c\u4e00 builder \u7b97\u4e24\u8fb9)\u6052\u771f\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_no_change_detectors", "label": "\u7981\u6b62\u53d8\u66f4\u63a2\u6d4b\u5668(No change detectors)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u53ea\u6709\u6709\u610f\u51b3\u7b56\u624d\u80fd\u8ba9\u5176\u5931\u8d25\u7684\u6d4b\u8bd5(\u5e38\u91cf\u503c\u3001\u7cbe\u786e\u6587\u6848\u3001\u79c1\u6709\u7ed3\u6784)\u5728\u91cd\u65b0\u8bbe\u8ba1\u65f6\u8bef\u62a5\u3001\u5728 bug \u65f6\u6c89\u7761;\u6d4b\u4f9d\u8d56\u8be5\u51b3\u7b56\u7684\u884c\u4e3a,\u800c\u975e\u51b3\u7b56\u672c\u8eab\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_behavior_not_text", "label": "\u6d4b\u884c\u4e3a,\u4e0d\u6d4b\u6587\u672c(Behavior, not text)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u65ad\u8a00\u811a\u672c/\u6280\u80fd/\u914d\u7f6e\u5305\u542b\u67d0\u884c\u53ea\u8bc1\u660e\u6e90\u7801\u662f\u6e90\u7801;\u5bf9\u53d7\u63a7\u8f93\u5165\u8fd0\u884c\u811a\u672c\u5e76\u65ad\u8a00\u8f93\u51fa\u3001\u526f\u4f5c\u7528\u6216\u9000\u51fa\u7801;\u6307\u5bfc agent \u7684\u6587\u6863\u7531\u6d88\u8d39\u65b9 agent \u7684\u884c\u4e3a\u68c0\u9a8c;\u7ed9\u4eba\u770b\u7684\u6563\u6587\u4e0d\u914d\u6d4b\u8bd5\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_boundary_contracts", "label": "\u6d4b\u4f60\u7684\u8fb9\u754c\u5951\u7ea6,\u4e0d\u6d4b\u6846\u67b6(Your code, not the framework)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u6d4b\u81ea\u5df1\u4ee3\u7801\u5728\u8fb9\u754c\u4e0a\u505a\u51fa\u7684\u5951\u7ea6(\u6ce8\u518c\u7684\u8def\u7531\u3001\u53d1\u51fa\u7684\u67e5\u8be2\u3001\u4ea7\u51fa\u7684 payload);\u4e0a\u6e38\u673a\u5236\u662f\u5176\u7ef4\u62a4\u8005\u7684\u6d4b\u8bd5;\u4e0a\u6e38\u884c\u4e3a\u771f\u4ee4\u4eba\u610f\u5916\u65f6\u5199\u4e00\u4e2a\u7a84\u7684\u8868\u5f81\u6d4b\u8bd5\u547d\u540d\u8be5\u5047\u8bbe;\u6784\u9020\u5668/getter/\u5e38\u91cf/\u5e73\u51e1\u8f6c\u53d1\u4ec5\u5728\u6821\u9a8c\u3001\u89c4\u8303\u5316\u3001\u9ed8\u8ba4\u3001\u63a8\u5bfc\u3001\u5f3a\u5236\u6216\u526f\u4f5c\u7528\u65f6\u624d\u914d\u6d4b\u8bd5\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_gate_function_naming", "label": "\u95e8\u51fd\u6570 1:\u5199\u6d4b\u8bd5\u4f53\u524d\u7684\u68c0\u67e5", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u547d\u540d\u4f1a\u8ba9\u6d4b\u8bd5\u5931\u8d25\u7684\u751f\u4ea7\u53d8\u66f4:\u8bf4\u4e0d\u51fa\u2192\u56f4\u7ed5\u53ef\u89c2\u5bdf\u884c\u4e3a\u91cd\u65b0\u8bbe\u8ba1;'\u6e90\u7801\u6587\u672c\u53d8\u4e86'\u2192\u8fd0\u884c\u4ea7\u7269\u65ad\u8a00\u5176\u6548\u679c;\u53ea\u6709\u6709\u610f\u51b3\u7b56\u2192\u53d8\u66f4\u63a2\u6d4b\u5668,\u6d4b\u4f9d\u8d56\u8be5\u51b3\u7b56\u7684\u884c\u4e3a;\u786e\u8ba4\u671f\u671b\u503c\u4e0d\u7ecf\u88ab\u6d4b\u4ee3\u7801\u63a8\u5bfc,\u5426\u5219\u6362\u6210\u5b57\u9762\u91cf\u6216\u624b\u5de5\u6821\u9a8c fixture\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_mock_assertions", "label": "mock \u4e0d\u914d\u62e5\u6709\u65ad\u8a00(The mock earns no assertions)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mock \u65ad\u8a00\u5728 mock \u5b58\u5728\u65f6\u901a\u8fc7\u3001\u7f3a\u5931\u65f6\u5931\u8d25,\u5bf9\u7ec4\u4ef6\u672c\u8eab\u4ec0\u4e48\u90fd\u6ca1\u8bf4;\u65ad\u8a00\u771f\u5b9e\u7ec4\u4ef6\u7684\u884c\u4e3a,\u5426\u5219\u89e3\u9664 mock \u6216\u5220\u6389\u65ad\u8a00;'Are we testing the behavior of a mock?'"}, {"id": "skills_test_driven_development_writing_good_tests_mock_at_right_level", "label": "\u5728\u6b63\u786e\u7684\u5c42\u7ea7 mock(Mock at the right level)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u66ff\u6362\u524d\u5148\u5f04\u6e05\u771f\u5b9e\u65b9\u6cd5\u7684\u5168\u90e8\u526f\u4f5c\u7528;mock \u6162\u7684\u6216\u5916\u90e8\u7684\u64cd\u4f5c,\u4fdd\u6301\u6d4b\u8bd5\u4f9d\u8d56\u7684\u90e8\u5206\u771f\u5b9e;\u4e0d\u786e\u5b9a\u65f6\u5148\u5bf9\u771f\u5b9e\u5b9e\u73b0\u8dd1\u6d4b\u8bd5\u89c2\u5bdf\u5b9e\u9645\u9700\u8981\u4ec0\u4e48\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_specific_doubles", "label": "\u8ba9\u66ff\u8eab\u5177\u4f53\u5316(Make doubles specific)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u53c2\u6570\u3001\u8c03\u7528\u6b21\u6570\u6216\u987a\u5e8f\u5c5e\u4e8e\u5951\u7ea6\u65f6\u8981\u65ad\u8a00\u5b83\u4eec;\u63a5\u53d7\u4efb\u4f55\u4e1c\u897f\u7684\u5047\u5bf9\u8c61\u9a8c\u8bc1\u4e0d\u4e86\u4efb\u4f55\u4e1c\u897f;\u7ed9\u6bcf\u4e2a\u5206\u652f(\u6210\u529f/\u9519\u8bef/\u7578\u5f62)\u5404\u81ea\u7684 fixture \u6216 spy,\u8ba9\u9519\u8bef\u5206\u652f\u65e0\u6cd5\u6ee1\u8db3\u671f\u671b\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_complete_mock_mirroring", "label": "\u5b8c\u6574\u955c\u50cf\u771f\u5b9e\u6570\u636e(Mirror real data completely)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u6309\u73b0\u5b9e\u5b58\u5728\u7684\u5b8c\u6574\u7ed3\u6784(\u6240\u6709\u5df2\u6587\u6863\u5316\u5b57\u6bb5)mock,\u800c\u975e\u53ea mock \u6d4b\u8bd5\u8bfb\u7684\u5b57\u6bb5;\u90e8\u5206 mock \u5728\u4e0b\u6e38\u8bfb\u5230\u7f3a\u5931\u5b57\u6bb5\u65f6\u9759\u9ed8\u5931\u8d25:\u6d4b\u8bd5\u901a\u8fc7\u800c\u96c6\u6210\u6302\u6389\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_production_methods_only", "label": "\u751f\u4ea7\u7c7b\u53ea\u643a\u5e26\u751f\u4ea7\u65b9\u6cd5(Production classes carry production methods only)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u53ea\u6709\u6d4b\u8bd5\u9700\u8981\u7684\u6e05\u7406\u653e\u5728\u6d4b\u8bd5\u5de5\u5177\u91cc,\u7edd\u4e0d\u4f5c\u4e3a\u751f\u4ea7\u7c7b\u4e0a\u7684 destroy();\u95ee:\u8fd9\u4e2a\u65b9\u6cd5\u53ea\u88ab\u6d4b\u8bd5\u8c03\u7528\u5417?\u8fd9\u4e2a\u7c7b\u62e5\u6709\u8be5\u8d44\u6e90\u7684\u751f\u547d\u5468\u671f\u5417?\u7b54\u6848\u4e3a\u5426\u2192\u6d4b\u8bd5\u5de5\u5177\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_prefer_real_components", "label": "\u771f\u5b9e\u7ec4\u4ef6\u4f18\u4e8e\u590d\u6742 mock(Prefer real components over complex mocks)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5f53 mock \u8bbe\u7f6e\u8d85\u8fc7\u6d4b\u8bd5\u903b\u8f91\u3001mock \u7f3a\u771f\u5b9e\u7ec4\u4ef6\u7684\u65b9\u6cd5\u3001\u6216 mock \u53d8\u52a8\u5bfc\u81f4\u6d4b\u8bd5\u6302\u6389\u65f6,\u5207\u6362\u4e3a\u4f7f\u7528\u771f\u5b9e\u7ec4\u4ef6\u7684\u96c6\u6210\u6d4b\u8bd5;'Do we need to be using a mock here?'"}, {"id": "skills_test_driven_development_writing_good_tests_gate_function_mocking", "label": "\u95e8\u51fd\u6570 2:\u52a0 mock \u6216\u6d4b\u8bd5\u8f85\u52a9\u524d\u7684\u68c0\u67e5", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5217\u51fa\u771f\u5b9e\u65b9\u6cd5\u7684\u526f\u4f5c\u7528,\u4fdd\u6301\u6d4b\u8bd5\u4f9d\u8d56\u7684\u526f\u4f5c\u7528\u771f\u5b9e\u2014\u2014\u53ea mock \u5176\u4e0b\u6162/\u5916\u90e8\u5c42\u7ea7;mock \u54cd\u5e94\u955c\u50cf\u5b8c\u6574\u771f\u5b9e\u7ed3\u6784;\u53ea\u88ab\u6d4b\u8bd5\u8c03\u7528\u7684\u65b9\u6cd5\u653e\u8fdb\u6d4b\u8bd5\u5de5\u5177;\u8981\u65ad\u8a00 mock \u672c\u8eab\u2192\u89e3\u9664\u6216\u5220\u6389\u65ad\u8a00\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_tests_ship_with_implementation", "label": "\u6d4b\u8bd5\u4e0e\u5b9e\u73b0\u4e00\u8d77\u4ea4\u4ed8(Tests ship with the implementation)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TDD \u5faa\u73af(\u5931\u8d25\u6d4b\u8bd5\u2192\u6700\u5c0f\u5b9e\u73b0\u2192\u91cd\u6784)\u5c31\u662f'\u5b8c\u6210'\u7684\u542b\u4e49;\u4ea4\u4ed8\u884c\u4e3a\u9700\u8981\u7684\u6d4b\u8bd5\u4e14\u4ec5\u8fd9\u4e9b:\u5e73\u51e1\u4ee3\u7801\u548c\u4eba\u7c7b\u6563\u6587\u4e0d\u914d\u6d4b\u8bd5,\u4e3a\u6ee1\u8db3\u6d41\u7a0b\u800c\u5199\u7684\u6d4b\u8bd5\u6c38\u8fdc\u82b1\u7ef4\u62a4\u6210\u672c\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_mutation_check", "label": "\u53d8\u5f02\u68c0\u67e5(The Mutation Check)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u6536\u5c3e\u524d\u5728\u5fc3\u91cc\u53d8\u5f02\u751f\u4ea7\u4ee3\u7801,\u6bcf\u4e2a\u73b0\u5b9e\u53d8\u5f02\u81f3\u5c11\u4e00\u4e2a\u6d4b\u8bd5\u5931\u8d25:\u9519\u8bef\u5e38\u91cf/\u53c2\u6570\u3001\u9519\u8bef\u5206\u652f\u5904\u7406\u3001\u7f3a\u5931\u72b6\u6001\u53d8\u66f4\u6216\u526f\u4f5c\u7528\u3001\u7a7a/\u9ed8\u8ba4\u8fd4\u56de\u3001\u7f3a\u5931\u5bf9\u96f6/\u7a7a/nil/\u672a\u6388\u6743/\u7578\u5f62\u8f93\u5165\u7684\u6821\u9a8c;\u6ca1\u6709\u6d4b\u8bd5\u6355\u83b7\u7684\u53d8\u5f02\u6807\u8bb0\u8be5\u884c\u4e3a\u672a\u53d7\u4fdd\u62a4\u2014\u2014\u6216\u8be5\u6d4b\u8bd5\u662f\u540c\u4e49\u53cd\u590d\u3002"}, {"id": "skills_test_driven_development_writing_good_tests_warning_signs", "label": "\u8b66\u793a\u4fe1\u53f7\u6e05\u5355(Warning Signs)", "file_type": "concept", "source_file": "skills/test-driven-development/writing-good-tests.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "setup \u4e0e\u65ad\u8a00\u5171\u4eab\u540c\u4e00\u5bf9\u8c61\u4