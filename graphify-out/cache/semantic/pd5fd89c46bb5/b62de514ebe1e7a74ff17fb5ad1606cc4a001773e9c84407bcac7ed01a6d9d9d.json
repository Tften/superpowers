0bb\u4efb\u52a1\u4f7f\u7528\u7684\u540d\u5b57\u4e0e\u7c7b\u578b\u7684\u552f\u4e00\u9014\u5f84;executing-plans \u7684 pre-flight \u626b\u63cf\u636e\u6b64\u68c0\u67e5\u4efb\u52a1\u95f4\u5171\u4eab\u63a5\u53e3"}, {"id": "skills_writing_plans_skill_global_constraints", "label": "Global Constraints(\u5168\u5c40\u7ea6\u675f)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "spec \u7684\u9879\u76ee\u7ea7\u8981\u6c42\u2014\u2014\u7248\u672c\u4e0b\u9650\u3001\u4f9d\u8d56\u9650\u5236\u3001\u547d\u540d\u4e0e\u6587\u6848\u89c4\u5219\u3001\u5e73\u53f0\u8981\u6c42\u2014\u2014\u9010\u6761\u4ece spec \u539f\u6837\u6284\u5f55;\u6bcf\u4e2a\u4efb\u52a1\u7684\u8981\u6c42\u9690\u5f0f\u5305\u542b\u672c\u8282"}, {"id": "skills_writing_plans_skill_review_focus", "label": "Review Focus(\u5ba1\u67e5\u7126\u70b9)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "spec \u9690\u542b\u4f46\u6ca1\u6709\u4efb\u4f55\u4efb\u52a1\u6d4b\u8bd5\u8986\u76d6\u7684\u3001\u6700\u53ef\u80fd\u54ac\u5230\u771f\u5b9e\u7528\u6237\u7684\u4e94\u4e2a\u8f93\u5165\u7c7b/\u5931\u8d25\u6a21\u5f0f,\u6bcf\u884c\u547d\u540d\u8f93\u5165\u4e0e\u5408\u7406\u9884\u671f,\u6700\u53ef\u80fd\u7684\u5728\u524d;\u6bcf\u884c\u628a\u9489\u4f4f\u5b83\u7684\u6d4b\u8bd5\u52a0\u5230\u62e5\u6709\u8be5\u4ee3\u7801\u7684\u4efb\u52a1;\u7a7a\u8282\u8868\u793a\u67e5\u8fc7\u4e14\u6ca1\u6709,\u800c\u975e\u8df3\u8fc7\u68c0\u67e5;\u7ec8\u5ba1\u65f6\u539f\u6587\u4ea4\u7ed9 reviewer \u9010\u9879\u68c0\u67e5"}, {"id": "skills_writing_plans_skill_no_placeholders", "label": "No Placeholders(\u7981\u6b62\u5360\u4f4d\u7b26)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "