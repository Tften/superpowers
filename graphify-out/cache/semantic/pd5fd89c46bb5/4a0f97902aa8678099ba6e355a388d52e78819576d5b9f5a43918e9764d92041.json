{"nodes": [{"id": "skills_brainstorming_skill_md", "label": "brainstorming \u6280\u80fd (SKILL.md)", "file_type": "document", "source_file": "skills/brainstorming/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_skill_md_shared_understanding", "label": "\u5efa\u7acb\u5171\u8bc6 (Establish Shared Understanding)", "file_type": "concept", "source_file": "skills/brainstorming/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "brainstorming \u7684\u4ea7\u51fa\u5fc5\u987b\u662f\u4f19\u4f34\u80fd\u8fa8\u8ba4\u5e76\u7ea0\u6b63\u7684\u7406\u89e3:\u5148\u53d1\u73b0\u610f\u56fe\u3001\u5199\u56de\u7406\u89e3(\u533a\u5206\u6240\u8bf4\u4e0e\u5047\u8bbe)\u3001\u628a\u610f\u56fe\u5e26\u8fdb\u8bbe\u8ba1\u5de5\u4ef6;\u8bf7\u6c42\u5df2\u542b\u76ee\u7684\u4e0e\u7ea6\u675f\u65f6\u76f4\u63a5\u53cd\u6620,\u4e0d\u91cd\u590d\u8ffd\u95ee,\u4e5f\u4e0d\u8981\u6c42\u5bf9\u65b9\u91cd\u65b0\u6388\u6743\u4efb\u52a1\u3002"}, {"id": "skills_brainstorming_skill_md_three_paths", "label": "\u4e09\u8def\u5f84\u5206\u7c7b (Spike / Bounded / Architectural)", "file_type": "concept", "source_file": "skills/brainstorming/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5148\u5206\u7c7b\u8bf7\u6c42\u89c4\u6a21\u5e76\u5927\u58f0\u8bf4\u51fa\u5206\u7c7b\u4ee5\u4fbf\u4f19\u4f34\u7ea0\u6b63:\u6309 Spike/Bounded/Architectural \u7f29\u653e\u6d41\u7a0b;\u62ff\u4e0d\u51c6\u65f6\u9009\u66f4\u91cd\u7684\u8def\u5f84\u3002"}, {"id": "skills_brainstorming_skill_md_spike_path", "label": "Spike \u8def\u5f84", "file_type": "concept", "source_file": "skills/brainstorming/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u53ef\u884c\u6027\u95ee\u9898\u7684\u4ea7\u51fa\u662f\u7b54\u6848\u800c\u975e\u4ee3\u7801:2-3 \u53e5\u5448\u73b0\u95ee\u9898\u4e0e\u63a2\u9488\u8ba1\u5212,\u70b9\u5934\u540e\u4ee5\u6b63\u786e\u6027\u5141\u8bb8\u7684\u6700\u4fbf\u5b9c\u65b9\u5f0f\u8c03\u67e5,\u4ea7\u7269\u6807\u8bb0\u4e3a\u4e00\u6b21\u6027;\u4fdd\u7559 spike \u4ee3\u7801\u662f\u65b0\u7684\u8bf7\u6c42,\u9700\u91cd\u65b0\u5206\u7c7b\u3002"}, {"id": "skills_brainstorming_skill_md_bounded_path", "label": "Bounded \u8def\u5f84", "file_type": "concept", "source_file": "skills/brainstorming/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "bounded \u8861\u91cf\u7684\u662f\u4ed3\u5e93\u800c\u975e\u719f\u6089\u5ea6:\u8981\u6539\u7684\u6d41\u7a0b\u5fc5\u987b\u5df2\u5b58\u5728\u53ef\u8bfb,\u5426\u5219\u662f architectural;\u5728\u804a\u5929\u91cc\u5448\u73b0\u77ed\u8bbe\u8ba1\u540e\u7684\u6279\u51c6\u4e0e spec \u4e00\u6837\u662f\u786c\u95e8\u2014\u2014\u5448\u73b0\u540e\u505c\u4e0b\u7b49\u660e\u786e\u7684 yes\u3002"}, {"id": "skills_brainstorming_skill_md_architectural_path", "label": "Architectural \u8def\u5f84", "file_type": "concept", "source_file": "skills/brainstorming/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u65b0\u9879\u76ee\u3001\u65b0\u5b50\u7cfb\u7edf\u3001\u6539\u63a5\u53e3\u5c5e architectural:\u8d70\u5b8c\u6574\u6d41\u7a0b(\u63d0\u95ee\u30012-3 \u4e2a\u65b9\u6848\u6743\u8861\u3001\u5206\u6bb5\u8bbe\u8ba1\u3001\u4e66\u9762 spec\u3001\u81ea\u5ba1\u3001\u7528\u6237\u5ba1\u67e5),\u7136\u540e\u552f\u4e00\u5141\u8bb8\u7684\u4e0b\u4e00\u6b65\u662f writing-plans\u3002"}, {"id": "skills_brainstorming_skill_md_hard_gate", "label": "HARD-GATE \u5b9e\u65bd\u524d\u7f6e\u95e8", "file_type": "concept", "source_file": "skills/brainstorming/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u56de\u590d\u53ea\u6279\u51c6\u5b9e\u9645\u5448\u73b0\u7684\u9636\u