{"nodes": [{"id": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign", "label": "SDD Fix-Loop Redesign Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_resume_fix_rounds", "label": "Resume-First Fix Rounds (1-3 Resume, 4-5 Fresh Implementer)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounds 1-3 resume the original implementer because its context is intact \u2014 it knows the task, the code, and its own choices; a loop that survives three resumes usually means the implementer cannot see its own problem, so rounds 4-5 bring fresh eyes and a capability bump in one move."}, {"id": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_five_round_breaker", "label": "Five-Round Circuit Breaker", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past the cap, rounds don't converge \u2014 the failure is structural. Adjudicate only at the cap (adjudicating earlier is pre-judging with a different name) and every adjudication is a ledger entry; silent discards are forbidden."}, {"id": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_scoped_re_review", "label": "Scoped Re-Review Protocol", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_ledger_line_formats", "label": "Ledger Line Formats", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_rationalization_table", "label": "Skip Rationalization Table", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign", "target": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_resume_fix_rounds", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign", "target": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_five_round_breaker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign", "target": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_scoped_re_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign", "target": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_ledger_line_formats", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-15-sdd-fix-loop-redesign.md", "source_location": null, "weight": 1.0}, {"source": "