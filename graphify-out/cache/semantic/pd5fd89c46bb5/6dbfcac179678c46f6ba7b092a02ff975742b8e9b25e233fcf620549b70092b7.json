{"nodes": [{"id": "skills_writing_skills_skill_md", "label": "writing-skills \u6280\u80fd (SKILL.md)", "file_type": "document", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_skill_md_tdd_mapping", "label": "\u6280\u80fd\u521b\u5efa\u7684 TDD \u6620\u5c04", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5199\u6280\u80fd\u5c31\u662f\u628a TDD \u5e94\u7528\u5230\u6d41\u7a0b\u6587\u6863:\u6d4b\u8bd5\u7528\u4f8b=\u5e26 subagent \u7684\u538b\u529b\u573a\u666f,\u751f\u4ea7\u4ee3\u7801=SKILL.md,RED=\u65e0\u6280\u80fd\u57fa\u7ebf\u884c\u4e3a,GREEN=agent \u9075\u5b88,REFACTOR=\u5835\u6f0f\u6d1e\u3002"}, {"id": "skills_writing_skills_skill_md_iron_law", "label": "\u94c1\u5f8b:\u6ca1\u6709\u5931\u8d25\u6d4b\u8bd5\u5c31\u6ca1\u6709\u6280\u80fd", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NO SKILL WITHOUT A FAILING TEST FIRST\u2014\u2014\u540c\u65f6\u9002\u7528\u4e8e\u65b0\u6280\u80fd\u4e0e\u5bf9\u73b0\u6709\u6280\u80fd\u7684\u7f16\u8f91;\u5148\u5199\u540e\u6d4b\u5c31\u5220\u6389\u91cd\u6765,\u5220\u9664\u5c31\u662f\u5220\u9664,\u4e0d\u7559'\u53c2\u8003'\u3002"}, {"id": "skills_writing_skills_skill_md_sdo", "label": "\u6280\u80fd\u53d1\u73b0\u4f18\u5316 (SDO)", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5b9e\u6d4b\u53d1\u73b0:\u63cf\u8ff0\u91cc\u6458\u8981\u5de5\u4f5c\u6d41('code review between tasks')\u4f1a\u8ba9 agent \u7167\u63cf\u8ff0\u53ea\u505a\u4e00\u6b21\u5ba1\u67e5\u800c\u4e0d\u8bfb\u6280\u80fd\u6b63\u6587;\u63cf\u8ff0\u53ea\u5199\u89e6\u53d1\u6761\u4ef6('Use when...')\u540e agent \u624d\u6b63\u786e\u9075\u5faa\u6d41\u7a0b\u56fe\u7684\u4e24\u9636\u6bb5\u5ba1\u67e5\u3002\u63cf\u8ff0\u6458\u8981\u5de5\u4f5c\u6d41\u4f1a\u9020\u6210 agent \u8d70\u7684\u6377\u5f84\u3002"}, {"id": "skills_writing_skills_skill_md_token_efficiency", "label": "Token \u6548\u7387", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getting-started \u4e0e\u9ad8\u9891\u6280\u80fd\u6ce8\u5165\u6bcf\u6b21\u4f1a\u8bdd,\u6bcf\u4e2a token \u90fd\u6709\u6210\u672c;\u7ec6\u8282\u79fb\u5230 --help\u3001\u8de8\u6280\u80fd\u5f15\u7528\u3001\u538b\u7f29\u793a\u4f8b\u3001\u6d88\u9664\u5197\u4f59\u3002"}, {"id": "skills_writing_skills_skill_md_skill_types", "label": "\u6280\u80fd\u7c7b\u578b (Technique / Pattern / Reference)", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_skill_md_bulletproofing", "label": "\u9632\u5408\u7406\u5316\u52a0\u56fa (Bulletproofing)", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u4ec5\u9002\u7528\u4e8e\u7eaa\u5f8b\u6027\u5931\u6548(\u77e5\u9053\u89c4\u5219\u5374\u5728\u538b\u529b\u4e0b\u8df3\u8fc7):\u663e\u5f0f\u5c01\u6b7b\u6bcf\u4e2a\u6f0f\u6d1e\u3001\u5207\u65ad'\u7cbe\u795e vs \u5b57\u9762'\u4e89\u8bba\u3001\u5efa\u5408\u7406\u5316\u8868\u3001\u5217 Red Flags;\u5bf9\u8f93\u51fa\u5f62\u72b6\u9519\u8bef\u6216\u9057\u6f0f\u5143\u7d20,\u7981\u6b62\u5f0f\u52a0\u56fa\u4f1a\u9002\u5f97\u5176\u53cd,\u5e94\u6539\u7528 Match the Form to the Failure \u7684\u5f62\u5f0f\u3002"}, {"id": "skills_writing_skills_skill_md_rationalization_table", "label": "\u5408\u7406\u5316\u5bf9\u7167\u8868 (Excuse vs Reality)", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u4ece\u57fa\u7ebf\u6d4b\u8bd5\u9010\u5b57\u6355\u83b7 agent \u7684\u6bcf\u4e2a\u501f\u53e3\u5e76\u914d'\u73b0\u5b9e'\u53cd\u9a73\u2014\u2014agent \u4f1a\u627e\u6f0f\u6d1e,\u8868\u683c\u8ba9\u5408\u7406\u5316\u65e0\u5904\u843d\u811a\u3002"}, {"id": "skills_writing_skills_skill_md_red_flags_list", "label": "Red Flags \u5217\u8868", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_skill_md_match_form_to_failure", "label": "\u5f62\u5f0f\u5339\u914d\u5931\u6548\u7c7b\u578b (Match the Form to the Failure)", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u63aa\u8f9e\u5bf9\u6bd4\u6d4b\u8bd5\u4e2d,\u7981\u6b62\u5f0f\u8868\u8ff0\u6bd4 recipe \u4ea7\u751f\u660e\u663e\u66f4\u591a unwanted \u5185\u5bb9,\u751a\u81f3\u5dee\u4e8e\u65e0\u5f15\u5bfc\u5bf9\u7167;recipe \u65e0\u53ef\u8c08\u5224\u4f59\u5730\u3002\u5355\u4e00 nuance \u4ece\u53e5\u4e5f\u4f1a\u628a\u7a33\u5b9a\u7684 recipe \u9000\u5316\u5230\u4e0d\u7a33\u5b9a\u2014\u2014\u771f\u6b63\u7684\u4f8b\u5916\u5e94\u5199\u6210\u57fa\u4e8e\u53ef\u89c2\u5bdf\u8c13\u8bcd\u7684\u72ec\u7acb\u6761\u4ef6\u53e5\u3002"}, {"id": "skills_writing_skills_skill_md_micro_tests", "label": "\u63aa\u8f9e\u5fae\u6d4b (Micro-Test Wording)", "file_type": "concept", "source_file": "skills/writing-skills/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u5168\u91cf\u538b\u529b\u573a\u666f\u6162\u4e14\u8d35,\u5148\u7528\u5fae\u6d4b\u9a8