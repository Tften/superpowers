{"nodes": [{"id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_document", "label": "Diagnosing Superpowers Sessions Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_diagnosing_superpowers_skill", "label": "diagnosing-superpowers skill", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The skill reports what happened with evidence; it never diagnoses superpowers - speculating about bugs or proposing changes is the remote triager's job, and the skill says so if asked."}, {"id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_context_safety_rules", "label": "Context-Safety Rules", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single transcript lines can hold 100k+ tokens (tool results, images, hook payloads); never cat or grep a transcript for content - counts and line numbers first, then small field extraction from specific lines."}, {"id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_finding_shape", "label": "path:line Finding Shape", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence or nothing: every finding cites path:line with a short quote and a confidence level; findings without a citation are dropped at reconciliation."}, {"id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_scrub_and_audit", "label": "Bundle Scrub and Independent Audit", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automated scrubbing can miss things: a second independent subagent audits until it finds nothing, stable placeholders preserve cross-references, and the user reviews the scrub log and file list before any archive is created."}, {"id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_similar_session_search", "label": "Similar-Session Signature Search", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confirmed findings become a greppable signature (skill name plus observed sequence, error string, date window); metadata-first discovery (mtime and size) avoids loading transcripts, and candidates are dispatched to parallel subagents."}], "edges": [{"source": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_document", "target": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_diagnosing_superpowers_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_document", "target": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_context_safety_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-27-diagnosing-superpowers-design.md", "source_location": null, "weight": 1.0}, {"sourc