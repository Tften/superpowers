{"nodes": [{"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_document", "label": "SDD Task-Scoped Review Dispatch Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_task_scoped_review", "label": "Task-Scoped Review", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-task quality prompts inherited merge-readiness framing from code-reviewer.md and cost 4-8x spec reviewers on the same tasks; scope per-task reviews to the task while the final whole-branch review stays broad."}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_task_reviewer_prompt", "label": "task-reviewer-prompt.md (merged spec and quality reviewer)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live eval economics showed per-dispatch overhead dominating cost; merging spec and quality reviews into one reviewer with two verdicts (one reading of the diff, one fix dispatch) beat baseline on every axis."}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_scope_budget", "label": "Reviewer Scope Budget", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start from the task diff; read changed files first; inspect adjacent code only for a named concrete risk. Cross-cutting changes are legitimate named risks - gate breadth behind a stated risk, do not forbid it."}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_test_budget", "label": "Reviewer Test Budget", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never re-run tests on code that has not changed: the implementer's report carries TDD RED/GREEN evidence; reviewers verify by reading and run only a focused test when reading raises a specific doubt."}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_evidence_rule", "label": "file:line Evidence Rule", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live eval runs showed reviewers passing defects the prompt pointed at with unsupported yes answers; requiring file:line evidence per check item closes that."}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_cannot_verify_from_diff", "label": "Cannot-Verify-From-Diff Channel", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requirements that cannot be verified from the diff become explicit flagged items the controller must resolve with cross-task context, instead of crawling the codebase or silently passing."}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_progress_ledger", "label": "SDD Durable Progress Ledger", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real sessions re-dispatched entire completed task sequences after compaction (269 dispatches for ~22 tasks); the progress.md ledger is the durable record the controller re-anchors on."}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_code_quality_reviewer_prompt", "label": "code-quality-reviewer-prompt.md", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_spec_reviewer_prompt", "label": "spec-reviewer-prompt.md", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_implementer_prompt", "label": "implementer-prompt.md", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_code_reviewer_template", "label": "requesting-code-review/code-reviewer.md template", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The broad template for final whole-branch review and ad-hoc review; per-task delegation removed, with an explicit final-review pointer kept so the template is not orphaned."}], "edges": [{"source": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_document", "target": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_task_scoped_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_document", "target": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_task_reviewer_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_document", "target": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_scope_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_document", "target": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_test_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-09-sdd-task-scoped-review-dispatch-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_document", "target": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_evidence_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_sc