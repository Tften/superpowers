{"nodes": [{"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_document", "label": "Worktree Rototill Detect-and-Defer Design (spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_detect_and_defer", "label": "Detect-and-Defer Worktree Strategy", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native harness worktree systems already manage paths, lifecycle, and cleanup; defer to them when present and fill the gap when absent. Detect state via git primitives, not platform sniffing - stable since git 2.5 and zero maintenance as new harnesses appear."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_step_0_detect_existing_isolation", "label": "Step 0: Detect Existing Isolation", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A worktree is a worktree regardless of origin; a submodule guard (show-superproject-working-tree) prevents false positives."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_step_0_5_consent", "label": "Step 0.5: Worktree Consent", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worktree creation becomes opt-in rather than mandatory; skipped entirely when Step 0 detects existing isolation."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_step_1a_native_tools", "label": "Step 1a: Native Worktree Tools (preferred)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The abstract wording failed at 2/6 because agents anchored on Step 1b's concrete git commands; explicit tool naming (EnterWorktree, WorktreeCreate, /worktree, --worktree) plus the consent bridge fixed it to 50/50 across GREEN and PRESSURE tests."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_step_1b_git_fallback", "label": "Step 1b: Git Worktree Fallback", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual worktree creation for harnesses without native tools: agent-instruction-file preference, then existing .worktrees/, then default; gitignore safety verification; git worktree add -b."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_provenance_based_ownership", "label": "Provenance-Based Worktree Ownership", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whoever creates the worktree owns its cleanup: paths under .worktrees/ or worktrees/ are superpowers-owned; branded harness paths (.claude/worktrees/, ~/.codex/worktrees/, .gemini/worktrees/) are hands-off."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_consent_bridge", "label": "Consent-Authorization Bridge", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tool descriptions override skill instructions (Claude Code #29950); EnterWorktree guards on explicit user request, so the skill must frame the user's Step 0.5 consent as the authorization the tool requires."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_worktree_prune", "label": "Stale Worktree Pruning", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Out-of-band deletions leave stale registrations that cause confusing errors; one git worktree prune line after any remove self-heals (idea from PR #1072)."}, {"id": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_hooks_symlinking", "label": "Worktree Hooks Symlinking", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git worktrees do not inherit the parent repo's hooks directory; symlinking .git/hooks prevents pre-commit checks from silently stopping (idea from PR #965)."}], "edges": [{"source": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_document", "target": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_detect_and_defer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_document", "target": "docs_superpowers_specs_2026_04_06_worktree_rototill_design_step_0_detect_existing_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "weight": 1.0},